{
    "name": "MedLookup",
    "version": "1.0.0",
    "manifest_version": 3,
    "description": "Medication lookup using RxNav + OpenFDA.",
    "action": {
        "default_title": "MedLookup",
        "default_popup": "popup.html"
    },
    "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://rxnav.nlm.nih.gov/*",
    "https://api.fda.gov/*"
  ]
}

