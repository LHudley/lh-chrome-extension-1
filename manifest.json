{
    "name": "RxLookup",
    "version": "1.0.0",
    "manifest_version": 3,
    "icons": {
        "16": "icons/imagemg16.png",
        "48": "icons/imagemg48.png",
        "128": "icons/imagemg48.png"
    },
    "description": "A quick medication lookup tool using RxNav + OpenFDA and Wikipedia.",
    "action": {
        "default_title": "RxLookup",
        "default_popup": "popup.html"
    },
    "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://rxnav.nlm.nih.gov/*",
    "https://api.fda.gov/*",
    "https://en.wikipedia.org/*"
  ]
}

